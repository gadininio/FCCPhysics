{
  "name": "365_medium_InclWWInFit",
  "title": "Cutflow for 365 GeV - Medium Selection - Inclusive WW in Fit",
  "signal_combined_name": "Z(ll)H",
  "scaleSig": 1.0,
  "cuts": [
    "All events",
    "4 leptons",
    "2 OS pairs",
    "#geq1 SF pair",
    "p_{l_{1}},p_{l_{2}},p_{l_{3}},p_{l_{4}}",
    "30 < m_{l^{+}l^{-}} < 200",
    "35 < p_{l^{+}l^{-}} < 155",
    "115 < m_{rec} < 230",
    "|cos#theta_{miss}| < 0.98",
    "20 < E_{miss} < 180",
    "m_{WW*} > 50",
    "0.1<#DeltaR(l_{WW*,1},l_{WW*,2})<4.0",
    "#DeltaR(Z#rightarrowll, WW*) > 3.0"
  ],
  "processes": {
    "signal": {
      "Z(ee)H": "wzp6_ee_eeH_HWW_ecm365",
      "Z(mumu)H": "wzp6_ee_mumuH_HWW_ecm365"
    },
    "backgrounds": {
      "ZZ": "p8_ee_ZZ_ecm365",
      "WW": "p8_ee_WW_ecm365",
      "tt": "p8_ee_tt_ecm365"
    }
  }
}

