{
  "name": "365_tight_norecoil",
  "title": "Cutflow for 365 GeV - Tight Selection (no recoil mass cut)",
  "signal_combined_name": "Z(ll)H",
  "scaleSig": 1.0,
  "cuts": [
    "All events",
    "4 leptons",
    "2 OS pairs",
    "#geq1 SF pair",
    "p_{l_{1}},p_{l_{2}},p_{l_{3}},p_{l_{4}}",
    "76 < m_{l^{+}l^{-}} < 106",
    "140 < p_{l^{+}l^{-}} < 150",
    "120 < m_{rec} < 140",
    "|cos#theta_{miss}| < 0.98",
    "30 < E_{miss} < 160",
    "80 < m_{WW*} < 130",
    "#DeltaR(l_{WW*,1},l_{WW*,2}) > 0.1"
  ],
  "processes": {
    "signal": {
      "Z(ee)H": "wzp6_ee_eeH_HWW_ecm365",
      "Z(mumu)H": "wzp6_ee_mumuH_HWW_ecm365"
    },
    "backgrounds": {
      "WW": "p8_ee_WW_ecm365",
      "ZZ": "p8_ee_ZZ_ecm365",
      "tt": "p8_ee_tt_ecm365"
    }
  }
}

