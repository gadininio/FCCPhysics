{
  "name": "365_loose_norecoil",
  "title": "Cutflow for 365 GeV - Loose Selection (no recoil mass cut)",
  "signal_combined_name": "Z(ll)H",
  "scaleSig": 1.0,
  "cuts": [
    "All events",
    "4 leptons",
    "2 OS pairs",
    "#geq1 SF pair",
    "p_{l_{1}},p_{l_{2}},p_{l_{3}},p_{l_{4}}",
    "76 < m_{l^{+}l^{-}} < 106",
    "35 < p_{l^{+}l^{-}} < 155",
    "120 < m_{rec} < 145",
    "|cos#theta_{miss}| < 0.98",
    "20 < E_{miss} < 170",
    "m_{WW*} > 50",
    "0.1<#DeltaR(l_{WW*,1},l_{WW*,2})<4.0"
  ],
  "processes": {
    "signal": {
      "Z(ee)H": "wzp6_ee_eeH_HWW_ecm365",
      "Z(mumu)H": "wzp6_ee_mumuH_HWW_ecm365"
    },
    "backgrounds": {
      "WW": "p8_ee_WW_ecm365",
      "ZZ": "p8_ee_ZZ_ecm365",
      "tt": "p8_ee_tt_ecm365"
    }
  }
}

