{
  "name": "365_medium3_InclWWInFit_iso",
  "title": "Cutflow for 365 GeV - Medium3 selection with lepton iso - Inclusive WW in Fit",
  "signal_combined_name": "Z(ll)H",
  "scaleSig": 1.0,
  "cuts": [
    "All events",
    "4 leptons",
    "Lepton iso",
    "2 OS pairs",
    "#geq1 SF pair",
    "Leptons p",
    "71 < m_{ll} < 111",
    "35 < p_{ll} < 155",
    "115 < m_{rec} < 230",
    "|cos#theta_{miss}| < 0.98",
    "20 < E_{miss} < 180",
    "m_{WW*} > 50",
    "0.1<#DeltaR(l_{W1},l_{W2})<4.0",
    "#DeltaR(Z#rightarrowll, WW*) > 3.0",
    "#DeltaR(l_{Z1}, l_{Z2}) < 3.0"
  ],
  "processes": {
    "signal": {
      "Z(ee)H": "wzp6_ee_eeH_HWW_ecm365",
      "Z(mumu)H": "wzp6_ee_mumuH_HWW_ecm365"
    },
    "backgrounds": {
      "ZZ": "p8_ee_ZZ_ecm365",
      "WW": "p8_ee_WW_ecm365",
      "tt": "p8_ee_tt_ecm365"
    }
  },
  "training_processes": {
    "signal": {
      "Z(ee)H": "wzp6_ee_eeH_HWW_ecm365",
      "Z(mumu)H": "wzp6_ee_mumuH_HWW_ecm365"
    },
    "backgrounds": {
      "ZZ_ll": ["p8_ee_ZZ_llX_ecm365", "p8_ee_ZZ_tautauX_ecm365"],
      "WW": "p8_ee_WW_ecm365",
      "WW_ll": ["p8_ee_WW_ee_ecm365", "p8_ee_WW_mumu_ecm365"]
    }
  }
}
